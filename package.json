{
  "name": "iu-praxisbericht",
  "version": "1.0.0",
  "description": "Fills IU myCampus Praxisberichte (weekly practice reports) from a task list",
  "scripts": {
    "plan": "tsx src/cli.ts plan",
    "fill": "tsx src/cli.ts fill",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "author": "GulfGulfinson <phillschnei@web.de>",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "dependencies": {
    "playwright": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true
}
